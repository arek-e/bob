# Shared Bob production environment contract.
# Secret-bearing deployables add their own local schemas.
#
# @defaultSensitive=false
# @defaultRequired=infer
# @cache=disabled
# ---

# OpenBao server address. This value is not a credential.
# @required
# @type=url
# @auditIgnore
BAO_ADDR=https://vault.lamb-bicolor.ts.net

# Optional short-lived workload identity role for trusted automation.
# @optional
BAO_JWT_ROLE=
