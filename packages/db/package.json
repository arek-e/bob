{
  "name": "@bob/db",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./database": "./src/database.ts",
    "./postgresql": "./src/postgresql.ts",
    "./schema/alerts": "./src/schema/alerts.ts",
    "./schema/artifacts": "./src/schema/artifacts.ts",
    "./schema/connections": "./src/schema/connections.ts",
    "./schema/conversations": "./src/schema/conversations.ts",
    "./schema/delivery": "./src/schema/delivery.ts",
    "./schema/journal": "./src/schema/journal.ts",
    "./schema/memory": "./src/schema/memory.ts",
    "./schema/observability": "./src/schema/observability.ts",
    "./schema/reminders": "./src/schema/reminders.ts",
    "./schema/retrieval": "./src/schema/retrieval.ts",
    "./schema/training": "./src/schema/training.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "better-auth": "1.6.26",
    "drizzle-orm": "1.0.0-rc.4",
    "postgres": "3.4.9"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.4"
  }
}
