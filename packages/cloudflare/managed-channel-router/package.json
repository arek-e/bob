{
  "name": "@bob/managed-channel-router",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=esm --platform=browser --target=es2023 --outfile=dist/index.js",
    "env:check": "varlock load --agent --path . --skip-cache",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bob/contracts": "workspace:*",
    "@bob/sendblue": "workspace:*",
    "effect": "4.0.0-beta.107"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260810.1",
    "esbuild": "0.25.9"
  }
}
