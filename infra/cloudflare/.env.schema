# Cloudflare deployment contract.
# @import(../../.env.schema, pick=[BAO_ADDR, BAO_JWT_ROLE])
# @plugin(@varlock/hashicorp-vault-plugin)
# @initHcpVault(url=$BAO_ADDR, pathPrefix="ops/apps/prod/bob", jwtRole=$BAO_JWT_ROLE, cacheTtl=false)
# @defaultSensitive=true
# @defaultRequired=true
# @generateTsTypes(path=./src/environment.generated.ts, exposeEnv=local)
# ---

# @auditIgnore
CLOUDFLARE_ACCOUNT_ID=vaultSecret("deploy")

# @auditIgnore
CLOUDFLARE_ZONE_ID=vaultSecret("deploy")

# @auditIgnore
CLOUDFLARE_API_TOKEN=vaultSecret("deploy")

# Account subdomain used for temporary workers.dev routes.
# @public @auditIgnore
CLOUDFLARE_WORKERS_SUBDOMAIN=vaultSecret("config")

# Existing Core Worker name. Keep this stable to preserve Worker-owned state.
# @public @auditIgnore
CLOUDFLARE_CORE_WORKER_NAME=vaultSecret("config")

# Base DNS zone for Bob routes.
# @public @auditIgnore
BOB_DOMAIN=vaultSecret("config")

# Email allowed to enter the private owner UI.
# @type=email @auditIgnore
OWNER_ACCESS_EMAIL=vaultSecret("config")

# Cloudflare Access team host. Example: example.cloudflareaccess.com.
# @public @auditIgnore
ACCESS_TEAM_DOMAIN=vaultSecret("config")

# Protected Coolify service reached by the private control-plane tunnel.
# @public @type=url @auditIgnore
AGENT_ORIGIN_URL=vaultSecret("config")

# Stable owner UUID.
# @auditIgnore
OWNER_ID=vaultSecret("config")

# @public @auditIgnore
OWNER_TIME_ZONE=vaultSecret("config")

# @public @auditIgnore @type=string
REMINDER_QUIET_HOURS_START=vaultSecret("config")

# @public @auditIgnore @type=string
REMINDER_QUIET_HOURS_END=vaultSecret("config")

# @public @auditIgnore @type=number(min=1,max=100,isInt=true)
REMINDER_DAILY_LIMIT=vaultSecret("config")

# @public @auditIgnore
BOB_MODEL=vaultSecret("config")

# @public @type=enum(openai-codex) @auditIgnore
BOB_PROVIDER=vaultSecret("config")

# Soft per-run token threshold. It creates an alert but does not stop a run.
# @public @type=number(min=1000,max=1000000,isInt=true) @auditIgnore
BOB_RUN_TOKEN_BUDGET=32000

# Soft UTC-day token threshold. It creates an alert but does not stop a run.
# @public @type=number(min=1000,max=10000000,isInt=true) @auditIgnore
BOB_DAILY_TOKEN_BUDGET=250000

# @auditIgnore
DATA_KEK_ACTIVE_VERSION=vaultSecret("app")

# @auditIgnore
DATA_KEK_KEYRING_JSON=vaultSecret("app")

# Stable keyed lookup secret. It is independent from KEK rotation.
# @auditIgnore
DATA_LOOKUP_KEY=vaultSecret("app")

# Better Auth session and token encryption secret.
# @auditIgnore
BETTER_AUTH_SECRET=vaultSecret("app")

# Nango development-environment API key. The same value reaches Nango through External Secrets.
# @auditIgnore
NANGO_SECRET_KEY=vaultSecret("nango/runtime")

# Enable only after live URLs and Sendblue reconciliation are ready.
# @public @type=boolean @auditIgnore
SENDBLUE_ENABLED=vaultSecret("config")

# Block production state use until its separate privacy review is complete.
# @public @type=boolean @auditIgnore
ALCHEMY_PRODUCTION_STATE_APPROVED=vaultSecret("config")

# Disable optional Alchemy CLI telemetry.
# @public @type=boolean @auditIgnore
ALCHEMY_TELEMETRY_DISABLED=vaultSecret("config")

# Require the content-free OpenBao handoff for the production plan.
# @public @type=boolean @auditIgnore
RUNTIME_CREDENTIAL_HANDOFF_ENABLED=vaultSecret("config")

# GitHub supplies this URL only to jobs with id-token: write.
# @public @optional @type=url @auditIgnore
ACTIONS_ID_TOKEN_REQUEST_URL=

# GitHub supplies this short-lived request bearer only to the current job.
# @optional @auditIgnore
ACTIONS_ID_TOKEN_REQUEST_TOKEN=

# Optional short-lived local child token for the scoped handoff only.
# @optional @auditIgnore
BAO_DEPLOY_TOKEN=

# Increment this value for each Access service-token rotation.
# @public @type=number(min=1,isInt=true) @auditIgnore
ACCESS_SERVICE_TOKEN_ROTATION_VERSION=vaultSecret("config")

# ISO timestamp. A release fails outside the next eight-day rotation window.
# @public @type=string @auditIgnore
ACCESS_SERVICE_TOKEN_ROTATE_BY=vaultSecret("config")

# Stable internal identifier for the linked Sendblue account.
# @required=$SENDBLUE_ENABLED @auditIgnore
SENDBLUE_ACCOUNT_ID=if($SENDBLUE_ENABLED, vaultSecret("config"), undefined)

# Stable internal identifier for the linked Sendblue line.
# @required=$SENDBLUE_ENABLED @auditIgnore
SENDBLUE_LINE_ID=if($SENDBLUE_ENABLED, vaultSecret("config"), undefined)

# @required=$SENDBLUE_ENABLED @auditIgnore
SENDBLUE_API_KEY_ID=if($SENDBLUE_ENABLED, vaultSecret("sendblue"), undefined)

# @required=$SENDBLUE_ENABLED @auditIgnore
SENDBLUE_API_SECRET_KEY=if($SENDBLUE_ENABLED, vaultSecret("sendblue"), undefined)

# @required=$SENDBLUE_ENABLED @auditIgnore
SENDBLUE_WEBHOOK_SIGNING_SECRET=if($SENDBLUE_ENABLED, vaultSecret("sendblue"), undefined)

# @required=$SENDBLUE_ENABLED @type=string(startsWith=+) @auditIgnore
SENDBLUE_FROM_NUMBER=if($SENDBLUE_ENABLED, vaultSecret("sendblue"), undefined)

# @required=$SENDBLUE_ENABLED @type=string(startsWith=+) @auditIgnore
SENDBLUE_ALLOWED_USER_NUMBER=if($SENDBLUE_ENABLED, vaultSecret("sendblue"), undefined)
