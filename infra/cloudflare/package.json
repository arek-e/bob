{
  "name": "@bob/cloudflare-infra",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "env:check": "varlock load --agent --path . --skip-cache",
    "load:check": "ALCHEMY_TELEMETRY_DISABLED=true alchemy plan alchemy.smoke.run.ts --stage prod --log-level error",
    "plan": "varlock run --inject all --skip-cache -- node src/run-alchemy.mjs plan",
    "test": "vitest run --config vitest.config.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@effect/platform-bun": "4.0.0-beta.102",
    "@effect/platform-node": "4.0.0-beta.102",
    "@effect/platform-node-shared": "4.0.0-beta.102",
    "@effect/sql-d1": "4.0.0-beta.102",
    "@effect/sql-sqlite-do": "4.0.0-beta.102",
    "@effect/vitest": "4.0.0-beta.102",
    "alchemy": "2.0.0-beta.70",
    "drizzle-kit": "1.0.0-rc.4",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.102"
  },
  "devDependencies": {
    "@types/node": "22.18.0",
    "@varlock/hashicorp-vault-plugin": "2.1.0",
    "typescript": "5.9.3",
    "varlock": "1.16.1",
    "vitest": "4.1.10"
  }
}
