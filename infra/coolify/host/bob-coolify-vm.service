[Unit]
Description=Bob Coolify virtual machine
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
ExecStart=/usr/bin/qemu-system-x86_64 \
  -name bob-coolify \
  -machine q35,accel=kvm \
  -cpu host \
  -smp 4 \
  -m 12288 \
  -drive file=/var/lib/bob-coolify-vm/root.qcow2,if=virtio,format=qcow2,cache=none,discard=unmap \
  -drive file=/var/lib/bob-coolify-vm/seed.img,if=virtio,format=raw,readonly=on \
  -device virtio-net-pci,netdev=net0 \
  -netdev "user,id=net0,hostname=bob-coolify,hostfwd=tcp:127.0.0.1:12222-:22,hostfwd=tcp:127.0.0.1:18000-:8000,hostfwd=tcp:127.0.0.1:16001-:6001,hostfwd=tcp:127.0.0.1:16002-:6002,guestfwd=tcp:10.0.2.100:8200-cmd:nc 10.107.147.209 8200,guestfwd=tcp:10.0.2.101:4318-cmd:nc 10.111.197.169 4318" \
  -object rng-random,filename=/dev/urandom,id=rng0 \
  -device virtio-rng-pci,rng=rng0 \
  -device virtio-balloon-pci \
  -chardev socket,path=/run/bob-coolify-vm-ga.sock,server=on,wait=off,id=qga0 \
  -device virtio-serial \
  -device virtserialport,chardev=qga0,name=org.qemu.guest_agent.0 \
  -qmp unix:/run/bob-coolify-vm.qmp,server=on,wait=off \
  -display none \
  -serial mon:stdio
Restart=on-failure
RestartSec=10
KillSignal=SIGTERM
TimeoutStopSec=120
LimitNOFILE=1048576

[Install]
WantedBy=multi-user.target
