{
  "schemaVersion": "bob.runtime.v1alpha1",
  "composeFile": "infra/coolify/compose.yaml",
  "composeDigest": "sha256:37b74cec68e96b6403890bd50b9fbd0d0585e6dc4241a0874bc93a1f5a727a8e",
  "services": [
    {
      "name": "agent-secret-init",
      "imageName": "agent",
      "imageEnvironmentVariable": "BOB_AGENT_IMAGE_DIGEST",
      "requiredConfiguration": [],
      "requiredSecrets": ["BAO_APPROLE_SECRET_ID"]
    },
    {
      "name": "agent",
      "imageName": "agent",
      "imageEnvironmentVariable": "BOB_AGENT_IMAGE_DIGEST",
      "requiredConfiguration": [
        "ACCESS_TEAM_DOMAIN",
        "ADMIN_ACCESS_AUDIENCE",
        "ADMIN_ACCESS_SUBJECT",
        "BAO_ADDR",
        "BAO_APPROLE_ROLE_ID",
        "BOB_ALLOWED_MODELS",
        "BOB_MODEL",
        "BOB_RELEASE_SHA",
        "CORE_ACCESS_CLIENT_ID",
        "CORE_URL",
        "OTEL_EXPORTER_OTLP_ENDPOINT",
        "RUN_ACCESS_AUDIENCE",
        "RUN_ACCESS_SUBJECT"
      ],
      "requiredSecrets": ["CORE_ACCESS_CLIENT_SECRET"]
    },
    {
      "name": "tunnel",
      "imageName": "cloudflared",
      "imageEnvironmentVariable": "CLOUDFLARED_IMAGE_DIGEST",
      "requiredConfiguration": [],
      "requiredSecrets": ["CLOUDFLARED_TUNNEL_TOKEN"]
    },
    {
      "name": "backup-runner",
      "imageName": "backup",
      "imageEnvironmentVariable": "BOB_BACKUP_IMAGE_DIGEST",
      "requiredConfiguration": [
        "BACKUP_AGE_RECIPIENT",
        "BACKUP_COPY_BUCKET",
        "BACKUP_COPY_ENDPOINT",
        "BACKUP_COPY_REGION",
        "CLOUDFLARE_ACCOUNT_ID",
        "CLOUDFLARE_D1_DATABASE_ID",
        "R2_BUCKET",
        "R2_ENDPOINT"
      ],
      "requiredSecrets": [
        "BACKUP_COPY_ACCESS_KEY_ID",
        "BACKUP_COPY_SECRET_ACCESS_KEY",
        "CLOUDFLARE_BACKUP_API_TOKEN",
        "R2_BACKUP_ACCESS_KEY_ID",
        "R2_BACKUP_SECRET_ACCESS_KEY"
      ]
    },
    {
      "name": "observer",
      "imageName": "observer",
      "imageEnvironmentVariable": "BOB_OBSERVER_IMAGE_DIGEST",
      "requiredConfiguration": ["OTEL_EXPORTER_OTLP_ENDPOINT"],
      "requiredSecrets": []
    }
  ],
  "readinessPath": "/v1/admin/readiness",
  "backupCommand": [
    "docker",
    "compose",
    "run",
    "--rm",
    "backup-runner",
    "node",
    "../../node_modules/varlock/bin/cli.js",
    "run",
    "--inject",
    "blob",
    "--skip-cache",
    "--",
    "node",
    "dist/index.mjs",
    "backup"
  ]
}
