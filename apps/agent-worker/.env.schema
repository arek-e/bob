# Private Node agent bootstrap contract.
# Pi OAuth fields are intentionally absent.
# @import(../../.env.schema, pick=[BAO_ADDR])
# @defaultSensitive=true
# @defaultRequired=true
# @generateTsTypes(path=./src/environment.generated.ts, exposeEnv=local, auto=false)
# ---

# @public @type=port @auditIgnore
PORT=8787

# @public @type=enum(kubernetes,approle) @auditIgnore
BAO_AUTH_METHOD=approle

# Kubernetes login role.
# @public @optional @auditIgnore
BAO_KUBERNETES_ROLE=

# @public @optional @auditIgnore
BAO_KUBERNETES_JWT_PATH=

# OpenBao AppRole role ID.
# @optional @auditIgnore
BAO_APPROLE_ROLE_ID=

# Local development fallback. Production uses BAO_APPROLE_SECRET_ID_PATH.
# @optional @auditIgnore
BAO_APPROLE_SECRET_ID=

# Use a file path when the runtime supports native secret mounts.
# @public @optional @auditIgnore
BAO_APPROLE_SECRET_ID_PATH=

# @public @type=enum(openai-codex) @auditIgnore
BOB_PROVIDER=openai-codex

# @public @auditIgnore
BOB_MODEL=gpt-5.6-luna

# Comma-separated model allowlist.
# @public @auditIgnore
BOB_ALLOWED_MODELS=gpt-5.6-luna

# Full source commit used to build the running agent image.
# @public @auditIgnore
BOB_RELEASE_SHA=

# OTLP/HTTP collector base URL.
# @public @type=url @auditIgnore
OTEL_EXPORTER_OTLP_ENDPOINT=

# Shared secret for calls from Core to Agent.
RUNTIME_SHARED_SECRET=

# Access-protected core Worker URL.
# @type=url @auditIgnore
CORE_URL=

# Shared secret for calls from Agent to Core.
# @auditIgnore
CORE_CALLER_SECRET=
