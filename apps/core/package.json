{
  "name": "@bob/core",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "esbuild src/index.ts --bundle --format=cjs --platform=node --target=node22 --loader:.sql=text --outfile=dist/index.cjs",
    "start": "node dist/index.cjs",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bob/contracts": "workspace:*",
    "@bob/core-runtime": "workspace:*",
    "@bob/db": "workspace:*",
    "@bob/job-queue": "workspace:*",
    "@bob/object-store": "workspace:*",
    "@bob/observability": "workspace:*",
    "bullmq": "6.1.2",
    "effect": "4.0.0-beta.107"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  }
}
