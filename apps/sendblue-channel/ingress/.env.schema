# Sendblue ingress deployment contract.
# @import(../../../.env.schema, pick=[BAO_ADDR, BAO_JWT_ROLE])
# @plugin(@varlock/hashicorp-vault-plugin)
# @initHcpVault(url=$BAO_ADDR, pathPrefix="ops/apps/prod/bob", jwtRole=$BAO_JWT_ROLE, cacheTtl=false)
# @defaultSensitive=true
# @defaultRequired=true
# @generateTsTypes(path=./src/environment.generated.ts, exposeEnv=local)
# ---

# Provider account identifier. This is not an API credential.
# @auditIgnore
SENDBLUE_ACCOUNT_ID=

# Provider line identifier. This is not an API credential.
# @auditIgnore
SENDBLUE_LINE_ID=

# @auditIgnore
SENDBLUE_WEBHOOK_SIGNING_SECRET=vaultSecret("sendblue")

# @type=string(startsWith=+) @auditIgnore
SENDBLUE_FROM_NUMBER=vaultSecret("sendblue")

# @type=string(startsWith=+) @auditIgnore
SENDBLUE_ALLOWED_USER_NUMBER=vaultSecret("sendblue")

# Alchemy-generated service-binding caller credential.
# @auditIgnore
CORE_CALLER_SECRET=

# Authenticated OTLP/HTTP collector base URL.
# @public @type=url @auditIgnore
OTEL_EXPORTER_OTLP_ENDPOINT=

# Cloudflare Access service token for the OTLP collector.
# @auditIgnore
OTEL_ACCESS_CLIENT_ID=

# Cloudflare Access service token secret for the OTLP collector.
# @auditIgnore
OTEL_ACCESS_CLIENT_SECRET=

# Full source commit used to build the Worker.
# @public @auditIgnore
BOB_RELEASE_SHA=
