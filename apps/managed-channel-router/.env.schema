# Managed Channel Router environment contract.
# @defaultSensitive=false
# @defaultRequired=infer
# @cache=disabled
# ---

# @required
SENDBLUE_ACCOUNT_ID=

# @required
SENDBLUE_LINE_ID=

# @required
# @sensitive
SENDBLUE_WEBHOOK_SIGNING_SECRET=

# @required
SENDBLUE_FROM_NUMBER=

# Key for deterministic sender lookup. Rotate with a dual-read migration.
# @required
# @sensitive
ROUTE_LOOKUP_KEY=

# Base64-encoded 32-byte AES-GCM key for staged events.
# @required
# @sensitive
ROUTER_EVENT_KEY=

# Stable identifier for the active staged-event key.
# @required
ROUTER_EVENT_KEY_VERSION=v1

# Token for managed route administration.
# @required
# @sensitive
ROUTER_ADMIN_TOKEN=

# @required
# @type=url
CONTROL_PLANE_URL=

# Scoped Control Plane caller token.
# @required
# @sensitive
CONTROL_PLANE_TOKEN=

# Scoped token for the managed Runtime ingress gateway.
# @required
# @sensitive
RUNTIME_INGRESS_TOKEN=

# Default placement region.
# @required
MANAGED_REGION=

# @required
MANAGED_ISOLATION_CLASS=microvm

# @required
MANAGED_RESOURCE_POLICY_ID=standard-v1

# @optional
MANAGED_RELEASE_CHANNEL=stable
