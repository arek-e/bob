# Core Worker deployment contract.
# @import(../../.env.schema, pick=[BAO_ADDR, BAO_JWT_ROLE])
# @plugin(@varlock/hashicorp-vault-plugin)
# @initHcpVault(url=$BAO_ADDR, pathPrefix="ops/apps/prod/bob", jwtRole=$BAO_JWT_ROLE, cacheTtl=false)
# @defaultSensitive=true
# @defaultRequired=true
# @generateTsTypes(path=./src/environment.generated.ts, exposeEnv=local)
# ---

# Stable owner identifier. Set this through the deployment environment.
# @auditIgnore
# @type=string(matches=/^[0-9a-f]{8}-[0-9a-f]{4}-[1-8][0-9a-f]{3}-[89ab][0-9a-f]{3}-[0-9a-f]{12}$/i)
OWNER_ID=

# @public @auditIgnore
OWNER_TIME_ZONE=Europe/Stockholm

# Owner-defined reminder quiet-hours start in local HH:MM format.
# @public @auditIgnore @type=string
REMINDER_QUIET_HOURS_START=

# Owner-defined reminder quiet-hours end in local HH:MM format.
# @public @auditIgnore @type=string
REMINDER_QUIET_HOURS_END=

# Owner-defined maximum reminder sends per local day.
# @public @auditIgnore @type=number(min=1,max=100,isInt=true)
REMINDER_DAILY_LIMIT=

# @auditIgnore
DATA_KEK_ACTIVE_VERSION=vaultSecret("app")

# @auditIgnore
DATA_KEK_KEYRING_JSON=vaultSecret("app")

# Stable HMAC key. Rotate this key only with a lookup-index migration.
# @auditIgnore
DATA_LOOKUP_KEY=vaultSecret("app")

# Alchemy-generated service-binding caller credentials.
# @auditIgnore
INGRESS_CALLER_SECRET=

# @auditIgnore
EGRESS_CALLER_SECRET=

# Public Sendblue egress Worker URL used for delivery status reconciliation.
# @public @type=url @auditIgnore
SENDBLUE_EGRESS_URL=

# Better Auth session and token encryption secret.
# @auditIgnore
BETTER_AUTH_SECRET=vaultSecret("app")

# @public @auditIgnore
ACCESS_TEAM_DOMAIN=

# @auditIgnore
CORE_ACCESS_AUDIENCE=

# Cloudflare Access audience for the one-time owner setup route.
# @auditIgnore
SETUP_ACCESS_AUDIENCE=

# @auditIgnore
OWNER_ACCESS_EMAIL=

# Cloudflare Access service-token subject allowed to call agent routes.
# @auditIgnore
AGENT_CALLER_SUBJECT=

# Private Tunnel URL for the Node agent host.
# @public @type=url @auditIgnore
AGENT_URL=

# @auditIgnore
AGENT_ACCESS_CLIENT_ID=vaultSecret("access/core-to-agent")

# @auditIgnore
AGENT_ACCESS_CLIENT_SECRET=vaultSecret("access/core-to-agent")

# Separate administration boundary for device login.
# @public @type=url @auditIgnore
AGENT_ADMIN_URL=

# @auditIgnore
AGENT_ADMIN_ACCESS_CLIENT_ID=vaultSecret("access/core-to-agent-admin")

# @auditIgnore
AGENT_ADMIN_ACCESS_CLIENT_SECRET=vaultSecret("access/core-to-agent-admin")

# Access-protected UI base URL.
# @public @type=url @auditIgnore
UI_BASE_URL=

# Public Nango API URL. OAuth callbacks use this origin.
# @public @type=url @auditIgnore
NANGO_API_URL=

# Nango development-environment API key. Bob never sends it to the browser.
# @auditIgnore
NANGO_SECRET_KEY=vaultSecret("nango/runtime")

# @public @auditIgnore
NANGO_GOOGLE_CALENDAR_INTEGRATION_ID=bob-google-calendar

# @public @auditIgnore
NANGO_MICROSOFT_CALENDAR_INTEGRATION_ID=bob-microsoft-calendar

# @public @auditIgnore
BOB_MODEL=gpt-5.6-luna

# @public @type=enum(openai-codex) @auditIgnore
BOB_PROVIDER=openai-codex

# Soft per-run token threshold. It creates an alert but does not stop a run.
# @public @type=number(min=1000,max=1000000,isInt=true) @auditIgnore
BOB_RUN_TOKEN_BUDGET=32000

# Soft UTC-day token threshold. It creates an alert but does not stop a run.
# @public @type=number(min=1000,max=10000000,isInt=true) @auditIgnore
BOB_DAILY_TOKEN_BUDGET=250000

# Full source commit used to build the Worker.
# @public @optional @type=string(matches=/^[a-f0-9]{40}$/) @auditIgnore
BOB_RELEASE_SHA=

# Authenticated OTLP/HTTP collector base URL.
# @public @optional @type=url @auditIgnore
OTEL_EXPORTER_OTLP_ENDPOINT=

# Cloudflare Access service token for the OTLP collector.
# @optional @auditIgnore
OTEL_ACCESS_CLIENT_ID=

# Cloudflare Access service token secret for the OTLP collector.
# @optional @auditIgnore
OTEL_ACCESS_CLIENT_SECRET=
