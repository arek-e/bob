# Private Node agent bootstrap contract.
# Pi OAuth fields are intentionally absent.
# @import(../../.env.schema, pick=[BAO_ADDR])
# @defaultSensitive=true
# @defaultRequired=true
# @generateTsTypes(path=./src/environment.generated.ts, exposeEnv=local, auto=false)
# ---

# @public @type=port @auditIgnore
PORT=8787

# @public @auditIgnore
BAO_KUBERNETES_ROLE=bob-agent

# @public @auditIgnore
BAO_KUBERNETES_JWT_PATH=/var/run/secrets/kubernetes.io/serviceaccount/token

# @public @type=enum(openai-codex) @auditIgnore
BOB_PROVIDER=openai-codex

# @public @auditIgnore
BOB_MODEL=gpt-5.6-luna

# Comma-separated model allowlist.
# @public @auditIgnore
BOB_ALLOWED_MODELS=gpt-5.6-luna

# Access-protected core Worker URL.
# @type=url @auditIgnore
CORE_URL=

# Injected from the External Secrets bootstrap Secret.
# @auditIgnore
CORE_ACCESS_CLIENT_ID=

# Injected from the External Secrets bootstrap Secret.
# @auditIgnore
CORE_ACCESS_CLIENT_SECRET=

# Cloudflare Access team domain.
# @auditIgnore
ACCESS_TEAM_DOMAIN=

# Cloudflare Access run application audience and allowed service-token subject.
# @auditIgnore
RUN_ACCESS_AUDIENCE=

# @auditIgnore
RUN_ACCESS_SUBJECT=

# Separate device-login administration application.
# @auditIgnore
ADMIN_ACCESS_AUDIENCE=

# @auditIgnore
ADMIN_ACCESS_SUBJECT=
