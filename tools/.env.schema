# Bob maintenance environment contract.
# The CLI reads selected production values from the existing Runtime Cluster
# secret. The schema does not copy or store secret values.
# @import(../.env.schema, pick=[BAO_ADDR, BAO_JWT_ROLE])
# @plugin(@varlock/hashicorp-vault-plugin)
# @initHcpVault(
#   url=$BAO_ADDR,
#   pathPrefix="ops/apps/prod/bob",
#   jwtRole=$BAO_JWT_ROLE,
#   cacheTtl=false
# )
# @defaultSensitive=true
# @defaultRequired=false
# @generateTsTypes(path=./environment.generated.ts, exposeEnv=local, auto=false)
# ---

# OpenBao-backed values from the shared Runtime Cluster secret.
# Local process values still take precedence over these resolvers.
# @optional
DATABASE_URL=vaultSecret("runtime-cluster#DATABASE_URL")

# @optional
DATA_KEK_ACTIVE_VERSION=vaultSecret("runtime-cluster#DATA_KEK_ACTIVE_VERSION")

# @optional
DATA_KEK_KEYRING_JSON=vaultSecret("runtime-cluster#DATA_KEK_KEYRING_JSON")

# @optional
DATA_LOOKUP_KEY=vaultSecret("runtime-cluster#DATA_LOOKUP_KEY")

# Maintenance scope and approval are supplied by the operator.
# @optional
BOB_OWNER_ID=

# @optional
BOB_MAINTENANCE_CONTENT_APPROVAL=

# Direct Control Plane access for job submission and status.
# The URL is public configuration. The operator token is read from the
# separate Control Plane OpenBao record and is never printed by the CLI.
# @public @optional @auditIgnore
BOB_MAINTENANCE_CONTROL_PLANE_URL=

# @optional
BOB_MAINTENANCE_CONTROL_PLANE_TOKEN=vaultSecret("control-plane/operator-access#OPERATOR_TOKEN")

# The human path defaults to a local development context. Agent invocations
# provide the target and image with flags. A cluster job also needs the release
# and execution IDs supplied by its runner.
# @public @optional @auditIgnore
BOB_MAINTENANCE_ENVIRONMENT=

# @public @optional @auditIgnore
BOB_MAINTENANCE_CLUSTER_ID=

# @public @optional @auditIgnore
BOB_MAINTENANCE_DEPLOYMENT_PROFILE_ID=

# @public @optional @auditIgnore
BOB_MAINTENANCE_TARGET_REGION=

# @public @optional @auditIgnore
BOB_MAINTENANCE_TARGET_PROVIDER=

# @public @optional @auditIgnore
BOB_MAINTENANCE_RUNTIME_ADAPTER=

# @public @optional @auditIgnore
BOB_MAINTENANCE_TARGET_REFERENCE=

# @public @optional @auditIgnore
BOB_MAINTENANCE_TARGET_ACCESS_POLICY_ID=

# @public @optional @auditIgnore
BOB_MAINTENANCE_TARGET_SOURCE=

# @public @optional @auditIgnore
BOB_MAINTENANCE_TARGET_SOURCE_REVISION=

# @public @optional @auditIgnore
BOB_MAINTENANCE_MODE=

# @public @optional @auditIgnore
BOB_MAINTENANCE_RELEASE_ID=

# @public @optional @auditIgnore
BOB_MAINTENANCE_EXECUTION_ID=

# @public @optional @auditIgnore
BOB_MAINTENANCE_IMAGE_SOURCE=

# @public @optional @auditIgnore
BOB_MAINTENANCE_IMAGE_DIGEST=

# @public @optional @auditIgnore
BOB_MAINTENANCE_SOURCE_REVISION=

# Non-secret command configuration.
# @public @optional @auditIgnore
BOB_MIGRATIONS_FOLDER=

# @public @optional @auditIgnore
OWNER_TIME_ZONE=UTC

# @public @optional @auditIgnore
BOB_CHANNEL_PROVIDER_ID=sendblue
