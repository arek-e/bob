# Bob independent backup contract.
# Kubernetes External Secrets supplies sensitive values in production.
# @defaultSensitive=true
# @defaultRequired=true
# @cache=disabled
# @generateTsTypes(path=./src/environment.generated.ts, exposeEnv=local, auto=false)
# ---

# @public @auditIgnore
CLOUDFLARE_ACCOUNT_ID=

# @public @auditIgnore
CLOUDFLARE_D1_DATABASE_ID=

# Read-only D1 and R2 backup credential.
# @auditIgnore
CLOUDFLARE_API_TOKEN=

# D1 Write token used only by an explicit restore drill.
# @optional @auditIgnore
CLOUDFLARE_RESTORE_API_TOKEN=

# @public @auditIgnore
R2_BUCKET=bob-private-prod

# @public @type=url @auditIgnore
R2_ENDPOINT=

# @auditIgnore
R2_ACCESS_KEY_ID=

# @auditIgnore
R2_SECRET_ACCESS_KEY=

# Broad recovery credentials. Never give these to the scheduled backup job.
# @optional @auditIgnore
R2_RESTORE_ACCESS_KEY_ID=

# @optional @auditIgnore
R2_RESTORE_SECRET_ACCESS_KEY=

# Public age X25519 recipient. The backup job never receives the identity.
# @public @auditIgnore
BACKUP_AGE_RECIPIENT=

# @public @auditIgnore
BACKUP_OUTPUT_DIRECTORY=/backups

# @public @type=number @auditIgnore
BACKUP_MAX_BYTES=268435456

# Keep six backups per day for seven days.
# @public @type=number @auditIgnore
BACKUP_RETENTION_COUNT=42

# Optional independent S3-compatible copy. Set all five connection fields together.
# @public @optional @type=url @auditIgnore
BACKUP_COPY_ENDPOINT=

# @public @optional @auditIgnore
BACKUP_COPY_REGION=

# @public @optional @auditIgnore
BACKUP_COPY_BUCKET=

# @public @auditIgnore
BACKUP_COPY_PREFIX=bob

# @optional @auditIgnore
BACKUP_COPY_ACCESS_KEY_ID=

# @optional @auditIgnore
BACKUP_COPY_SECRET_ACCESS_KEY=

# Required only by the verify command. Mount it as a file, not an environment value.
# @public @optional @auditIgnore
BACKUP_INPUT_FILE=

# Required only by the verify command.
# @public @optional @auditIgnore
BACKUP_AGE_IDENTITY_FILE=

# @public @auditIgnore
BACKUP_MIGRATIONS_DIRECTORY=../../apps/core-worker/migrations

# @public @auditIgnore
BACKUP_RESTORE_DATABASE_PREFIX=bob-restore-drill

# @public @auditIgnore
BACKUP_RESTORE_BUCKET_PREFIX=bob-restore-drill
