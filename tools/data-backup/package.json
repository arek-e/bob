{
  "name": "@bob/data-backup",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "backup": "varlock run --inject blob --skip-cache -- tsx src/index.ts backup",
    "build": "esbuild src/index.ts --bundle --format=esm --platform=node --target=node22 --outfile=dist/index.mjs",
    "env:check": "varlock load --agent --path . --skip-cache",
    "typecheck": "tsc -p tsconfig.json",
    "verify": "varlock run --inject blob --skip-cache -- tsx src/index.ts verify"
  },
  "dependencies": {
    "age-encryption": "0.3.0",
    "aws4fetch": "1.0.20",
    "effect": "4.0.0-beta.107",
    "varlock": "1.16.1"
  },
  "devDependencies": {
    "esbuild": "0.25.9"
  }
}
