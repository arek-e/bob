      "entityType": "checks",
      "table": "benchmark_artifacts"
    },
    {
      "value": "\"protocol\" in ('official', 'adapted')",
      "name": "benchmark_runs_protocol_ck",
      "entityType": "checks",
      "table": "benchmark_runs"
    },
    {
      "value": "\"status\" in ('queued', 'running', 'completed', 'failed', 'cancelled')",
      "name": "benchmark_runs_status_ck",
      "entityType": "checks",
      "table": "benchmark_runs"
    },
    {
      "value": "\"trigger\" in ('manual', 'scheduled', 'release')",
      "name": "benchmark_runs_trigger_ck",
      "entityType": "checks",
      "table": "benchmark_runs"
    },
    {
      "value": "length(\"bob_revision\") = 40 and \"bob_revision\" not glob '*[^0-9a-f]*'",
      "name": "benchmark_runs_bob_revision_ck",
      "entityType": "checks",
      "table": "benchmark_runs"
    },
    {
      "value": "length(\"benchmark_revision\") = 40 and \"benchmark_revision\" not glob '*[^0-9a-f]*'",
      "name": "benchmark_runs_benchmark_revision_ck",
      "entityType": "checks",
      "table": "benchmark_runs"
    },
    {
      "value": "\"sample_count\" >= 1",
      "name": "benchmark_runs_sample_count_ck",
      "entityType": "checks",
      "table": "benchmark_runs"
    },
    {
      "value": "\"repeat_count\" between 1 and 100",
      "name": "benchmark_runs_repeat_count_ck",
