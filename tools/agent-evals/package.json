{
  "name": "@bob/agent-evals",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "exports": {
    ".": "./src/index.ts",
    "./runtime": "./src/runtime.ts"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "db:generate": "drizzle-kit generate --config drizzle.config.ts",
    "eval": "tsx src/index.ts offline",
    "eval:benchmarks": "tsx src/index.ts benchmarks",
    "eval:compare": "tsx src/index.ts compare",
    "eval:offline": "tsx src/index.ts offline",
    "eval:interaction": "tsx src/index.ts offline --suite ../../evals/scenarios/v2/interaction-cases.json --candidates ../../evals/fixtures/v2/offline-candidates.json",
    "eval:live": "tsx src/index.ts live",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bob/contracts": "workspace:*",
    "drizzle-orm": "1.0.0-rc.4",
    "effect": "4.0.0-beta.107"
  },
  "devDependencies": {
    "drizzle-kit": "1.0.0-rc.4"
  }
}
