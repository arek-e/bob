{
  "name": "@bob/sendblue-reconcile",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "env:check": "varlock load --agent --path . --skip-cache",
    "reconcile": "varlock run --inject vars --skip-cache -- tsx src/index.ts",
    "typecheck": "tsc -p tsconfig.json"
  },
  "dependencies": {
    "@bob/sendblue": "workspace:*",
    "effect": "4.0.0-beta.107"
  }
}
