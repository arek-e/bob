[mcp_servers.coolify]
url = "https://coolify.lamb-bicolor.ts.net/mcp"
bearer_token_env_var = "COOLIFY_MCP_TOKEN"
default_tools_approval_mode = "writes"
enabled_tools = [
  "get_infrastructure_overview",
  "search_resources",
  "list_unhealthy_resources",
  "list_projects",
  "get_project",
  "get_environment",
  "list_resources",
  "list_applications",
  "get_application",
  "list_databases",
  "get_database",
  "list_database_backups",
  "list_backup_executions",
  "list_deployments",
  "get_deployment",
  "get_logs",
  "list_env_keys",
  "list_shared_env_keys",
  "list_storages",
  "list_scheduled_tasks",
  "list_scheduled_task_executions",
  "deploy",
  "cancel_deployment",
  "control"
]
