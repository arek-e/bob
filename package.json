{
  "name": "bob",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "check": "pnpm format:check && pnpm lint && pnpm typecheck && pnpm test && pnpm build",
    "env:check": "pnpm -r --if-present env:check",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "hooks:install": "lefthook install",
    "hooks:run": "lefthook run pre-commit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "pnpm test:unit",
    "test:unit": "vitest run",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @bob/db db:generate",
    "agent:check": "pnpm --filter @bob/pi-agent typecheck && pnpm --filter @bob/agent typecheck && pnpm exec vitest run packages/pi-agent/test apps/agent/test && pnpm --filter @bob/agent build",
    "agent:start": "pnpm --filter @bob/agent start"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20260810.1",
    "@effect/vitest": "4.0.0-beta.107",
    "@tanstack/router-generator": "1.167.27",
    "@types/node": "22.18.0",
    "@varlock/hashicorp-vault-plugin": "2.1.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "typescript": "5.9.3",
    "varlock": "1.16.1",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.19.0"
}
