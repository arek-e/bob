{
  "name": "bob",
  "private": true,
  "license": "AGPL-3.0-only",
  "type": "module",
  "scripts": {
    "build": "pnpm -r --if-present build",
    "build:artifacts": "pnpm --filter './apps/**' --filter @bob/data-backup --if-present build",
    "check": "pnpm check:static && pnpm infra:load && pnpm typecheck && pnpm eval:offline && pnpm test && pnpm build:artifacts && pnpm ui:safety",
    "check:static": "pnpm format:check && pnpm lint && pnpm boundaries && pnpm deps:check && pnpm env:schema && pnpm env:audit",
    "boundaries": "node scripts/verify-boundaries.mjs",
    "deps:check": "node scripts/verify-dependency-versions.mjs",
    "env:check": "pnpm -r --if-present env:check",
    "env:audit": "node scripts/audit-env-schemas.mjs",
    "env:schema": "node scripts/validate-env-schemas.mjs",
    "eval:offline": "pnpm --filter @bob/agent-evals eval:core && pnpm --filter @bob/agent-evals eval:offline && pnpm --filter @bob/agent-evals eval:benchmarks",
    "format": "oxfmt",
    "format:check": "oxfmt --check",
    "hooks:install": "lefthook install",
    "hooks:run": "lefthook run pre-commit",
    "lint": "oxlint .",
    "lint:fix": "oxlint --fix .",
    "test": "pnpm test:unit && pnpm test:workers",
    "test:unit": "vitest run",
    "test:workers": "pnpm --filter @bob/core-worker test:workers && pnpm --filter @bob/eval-worker test:workers",
    "test:watch": "vitest",
    "typecheck": "pnpm -r --if-present typecheck",
    "db:generate": "pnpm --filter @bob/core-worker db:generate",
    "sendblue:reconcile": "pnpm --filter @bob/sendblue-reconcile reconcile",
    "agent:check": "pnpm --filter @bob/pi-agent typecheck && pnpm --filter @bob/agent typecheck && pnpm --filter @bob/pi-smoke typecheck && pnpm exec vitest run packages/pi-agent/test apps/agent/test tools/pi-smoke/test && pnpm --filter @bob/agent build && pnpm eval:offline",
    "agent:smoke:predeploy": "pnpm --filter @bob/pi-smoke smoke:predeploy",
    "agent:start": "pnpm --filter @bob/agent start",
    "infra:plan": "pnpm --filter @bob/cloudflare-infra plan",
    "infra:evals:deploy": "pnpm --filter @bob/cloudflare-infra evals:deploy",
    "infra:evals:load": "pnpm --filter @bob/cloudflare-infra evals:load",
    "infra:evals:plan": "pnpm --filter @bob/cloudflare-infra evals:plan",
    "infra:load": "pnpm --filter @bob/cloudflare-infra load:check",
    "coolify:check": "node scripts/validate-coolify-compose.mjs",
    "compose:check": "node scripts/validate-portable-compose.mjs",
    "compose:smoke": "node scripts/smoke-portable-compose.mjs",
    "secrets:scan:staged": "varlock scan --staged --path apps/core-worker --path apps/connections-gateway --path apps/sendblue-ingress --path apps/sendblue-egress --path apps/managed-channel-router --path apps/agent --path tools/sendblue-reconcile --path tools/pi-smoke --path tools/data-backup --path infra/cloudflare",
    "secrets:scan:trusted": "node scripts/scan-trusted-secrets.mjs",
    "ui:safety": "node scripts/verify-ui-safety.mjs"
  },
  "devDependencies": {
    "@cloudflare/vitest-pool-workers": "0.21.0",
    "@cloudflare/workers-types": "5.20260810.1",
    "@effect/vitest": "4.0.0-beta.107",
    "@oxlint/plugins": "1.78.0",
    "@types/node": "22.18.0",
    "@varlock/hashicorp-vault-plugin": "2.1.0",
    "lefthook": "2.1.10",
    "oxfmt": "0.63.0",
    "oxlint": "1.78.0",
    "tsx": "4.23.12",
    "typescript": "5.9.3",
    "varlock": "1.16.1",
    "vitest": "4.1.9"
  },
  "engines": {
    "node": ">=22.19.0"
  },
  "packageManager": "pnpm@10.19.0"
}
